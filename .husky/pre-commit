#!/bin/sh

# Get list of staged files before running check so we can restage only
# the files the user intended to commit if formatting rewrites them.
STAGED_FILES=$(git diff --cached --name-only --diff-filter=ACMR)

node scripts/check-lockfile-commit.mjs
if [ $? -ne 0 ]; then
  exit 1
fi

# Run the check script (formatting, linting, and type checking)
echo "Running formatting, linting, and type checking..."
npm run check
if [ $? -ne 0 ]; then
  echo "❌ Checks failed. Please fix the errors before committing."
  exit 1
fi

RUN_BROWSER_SMOKE=0
if printf '%s\n' "$STAGED_FILES" | grep -Eq '^(packages/ai/|packages/web-ui/|package\.json$|package-lock\.json$)'; then
  RUN_BROWSER_SMOKE=1
fi

if [ $RUN_BROWSER_SMOKE -eq 1 ]; then
  echo "Running browser smoke check..."
  npm run check:browser-smoke
  if [ $? -ne 0 ]; then
    echo "❌ Browser smoke check failed."
    exit 1
  fi
fi

# Restage files that were previously staged and may have been modified by formatting.
if [ -n "$STAGED_FILES" ]; then
  printf '%s\n' "$STAGED_FILES" | while IFS= read -r file; do
    if [ -f "$file" ]; then
      git add "$file"
    fi
  done
fi

echo "✅ All pre-commit checks passed!"
