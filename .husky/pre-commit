#!/bin/sh

# Get list of staged files before running any formatter so we can restage only
# the files the user intended to commit, even if later checks fail.
STAGED_FILES=$(git diff --cached --name-only --diff-filter=ACMR)

restage_staged_files() {
  if [ -z "$STAGED_FILES" ]; then
    return
  fi

  printf '%s\n' "$STAGED_FILES" | while IFS= read -r file; do
    if [ -f "$file" ]; then
      git add "$file"
    fi
  done
}

RUN_BROWSER_SMOKE=0
if printf '%s\n' "$STAGED_FILES" | grep -Eq '^(packages/ai/|packages/web-ui/|package\.json$|package-lock\.json$)'; then
  RUN_BROWSER_SMOKE=1
fi

# Format first so that even if later checks fail and the commit is retried with a
# manual override, the staged files are already normalized.
echo "Running staged formatting..."
npx biome format --write --staged --no-errors-on-unmatched
FORMAT_STATUS=$?
restage_staged_files
if [ $FORMAT_STATUS -ne 0 ]; then
  echo "❌ Staged formatting failed. Please fix the errors before committing."
  exit 1
fi

# Then run the validation steps without rewriting files again.
echo "Running linting and type checking..."
npx biome check --error-on-warnings .
CHECK_STATUS=$?
if [ $CHECK_STATUS -ne 0 ]; then
  restage_staged_files
  echo "❌ Checks failed. Formatted staged files have been restaged."
  exit 1
fi

tsgo --noEmit
CHECK_STATUS=$?
if [ $CHECK_STATUS -ne 0 ]; then
  restage_staged_files
  echo "❌ Type checking failed. Formatted staged files have been restaged."
  exit 1
fi

if [ $RUN_BROWSER_SMOKE -eq 1 ]; then
  echo "Running browser smoke check..."
  npm run check:browser-smoke
  if [ $? -ne 0 ]; then
    restage_staged_files
    echo "❌ Browser smoke check failed. Formatted staged files have been restaged."
    exit 1
  fi
fi

(cd packages/web-ui && npm run check)
CHECK_STATUS=$?
restage_staged_files
if [ $CHECK_STATUS -ne 0 ]; then
  echo "❌ Web UI checks failed. Formatted staged files have been restaged."
  exit 1
fi

echo "✅ All pre-commit checks passed!"
